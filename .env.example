FSTACK_DATABASE_URL=postgresql+psycopg://fstack:replace-me@localhost:5432/fstack
FSTACK_OPERATOR_TOKEN=replace-with-a-long-random-operator-token

# Local Docker runtime
FSTACK_DOCKER_NETWORK=replace-with-installation-network
FSTACK_LOCAL_SECRET_ROOT=/replace/with/source-secret-root
FSTACK_SECRET_STAGE_ROOT=/replace/with/runtime-secret-root

# Installation-managed Caddy; these are fixed installation configuration, not request data.
FSTACK_CADDY_ADMIN_ROOT=/replace/with/trusted-caddy-admin-root
FSTACK_CADDY_ADMIN_UID=replace-with-socket-owner-uid
FSTACK_CADDY_ADMIN_GID=replace-with-socket-group-gid
FSTACK_CADDY_PROBE_ADDRESS=replace-with-fixed-caddy-network-ip:replace-with-listener-port
FSTACK_CADDY_CONTAINER_NAME=replace-with-canonical-caddy-container-name
